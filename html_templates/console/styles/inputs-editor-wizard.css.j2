      .runtime-wiz-close { position: absolute; top: 16px; right: 16px; color: var(--text-subtle); background: transparent; border: none; cursor: pointer; transition: color .15s ease; }
      .runtime-wiz-close:hover { color: #fff; }
      .runtime-wiz-progressbar { height: 4px; border-radius: 999px; background: rgba(255,255,255,0.08); overflow: hidden; margin-bottom: 18px; }
      .runtime-wiz-progressbar > span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, #3b82f6, #60a5fa); width: 0; transition: width 0.4s cubic-bezier(0.16,0.84,0.44,1); }
      .runtime-wiz-progress { font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em; color: var(--accent); font-weight: 700; }
      .runtime-wiz-step { animation: wizStepIn 0.28s cubic-bezier(0.16,0.84,0.44,1); }
      .runtime-wiz-q { font-size: 26px; line-height: 1.2; color: #fff; margin-top: 10px; font-weight: 600; }
      .runtime-wiz-help { font-size: 14px; color: var(--text-muted); margin-top: 12px; line-height: 1.55; }
      .runtime-wiz-field { margin-top: 24px; }
      .runtime-wiz-input { width: 100%; box-sizing: border-box; background: #050507; border: 1px solid rgba(255,255,255,0.14); border-radius: 12px; padding: 15px 18px; font-size: 16px; color: #fff; font-family: ui-monospace, monospace; transition: border-color .15s ease, box-shadow .15s ease; }
      .runtime-wiz-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(59,130,246,0.18); }
      .runtime-wiz-kinds { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 10px; }
      .runtime-wiz-kind { display: flex; align-items: center; gap: 10px; padding: 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.12); background: rgba(255,255,255,0.02); color: #fff; cursor: pointer; font-size: 14px; text-align: left; transition: border-color .15s ease, background .15s ease, transform .15s ease; }
      .runtime-wiz-kind:hover { border-color: var(--accent); transform: translateY(-2px); }
      .runtime-wiz-kind.selected { border-color: var(--accent); background: rgba(59,130,246,0.12); }
      .runtime-wiz-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 32px; gap: 12px; }
      .runtime-wiz-advanced { display: block; width: 100%; margin-top: 18px; text-align: center; font-size: 12px; color: var(--text-subtle); background: transparent; border: none; cursor: pointer; transition: color .15s ease; }
      .runtime-wiz-advanced:hover { color: var(--text-muted); }
      .runtime-wiz-summary { font-size: 16px; color: #fff; line-height: 1.6; }
      .runtime-wiz-dl { margin-top: 18px; display: grid; gap: 0; }
      .runtime-wiz-dl > div { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.08); }
      .runtime-wiz-dl dt { font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--text-subtle); }
      .runtime-wiz-dl dd { font-family: ui-monospace, monospace; font-size: 13px; color: #fff; text-align: right; word-break: break-all; }
      .runtime-wiz-callout { margin-top: 22px; border: 1px solid rgba(59,130,246,0.28); background: rgba(59,130,246,0.08); border-radius: 14px; padding: 18px 20px; display: flex; gap: 14px; align-items: flex-start; }
      .runtime-wiz-callout i { color: #60a5fa; flex-shrink: 0; margin-top: 2px; }
      .runtime-wiz-callout h4 { font-size: 14px; font-weight: 700; color: #fff; margin: 0 0 6px; }
      .runtime-wiz-callout p { font-size: 13px; color: var(--text-muted); line-height: 1.55; margin: 0; }
      .runtime-wiz-optional { margin-top: 18px; }
