      @keyframes wizOverlayIn { from { opacity: 0; } to { opacity: 1; } }
      @keyframes wizCardIn { from { opacity: 0; transform: translateY(18px) scale(0.985); } to { opacity: 1; transform: none; } }
      @keyframes wizStepIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      .runtime-wiz-card {
        position: relative; width: 100%; max-width: 660px;
        background: var(--panel-bg); border: 1px solid var(--panel-border);
        border-radius: 20px; padding: 40px;
