            v === undefined ||
            v === "" ||
            (Array.isArray(v) && !v.length) ||
            (v &&
              typeof v === "object" &&
              !Array.isArray(v) &&
              !Object.keys(v).length);
          if (empty) delete cfg[key];
          else cfg[key] = v;
