              .split("\n")
              .forEach((line) => {
                const parts = line.split(/[:=]/);
                if (parts.length >= 2) {
                  const k = parts[0].trim(),
                    val = parts.slice(1).join(":").trim();
                  if (k) {
                    const num = Number(val);
                    v[k] = val !== "" && !Number.isNaN(num) ? num : val;
                  }
                }
              });
          } else if (type === "json") {
            const t = String(raw).trim();
            if (!t) v = undefined;
