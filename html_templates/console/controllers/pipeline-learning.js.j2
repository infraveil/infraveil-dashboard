        async function handlePipelineImport(event) {
          const file = event.target.files && event.target.files[0];
          if (!file) return;
          try {
            if (file.size > 1024 * 1024) throw new Error("Pipeline files must be at most 1 MiB.");
            const parsed = JSON.parse(await file.text());
            if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) throw new Error("Import a pipeline object, not an array or scalar.");
            const candidate = parsed.stack || parsed.global || parsed;
            if (!candidate || typeof candidate !== "object" || Array.isArray(candidate)) throw new Error("The imported stack must be an object.");
            if (!Array.isArray(candidate.pipeline_stacks) && !Array.isArray(candidate.telemetry_pipeline) && !Array.isArray(candidate.response_pipeline)) throw new Error("The file must contain pipeline_stacks or capture/action pipeline arrays.");
            const stacks = candidate.pipeline_stacks || [candidate];
            if (stacks.length > 100) throw new Error("Import at most 100 stacks at a time.");
            stacks.forEach((stack) => {
              if (!stack || typeof stack !== "object" || Array.isArray(stack)) throw new Error("Each stack must be an object.");
              if (stack.id && !/^[A-Za-z0-9:_-]{1,100}$/.test(String(stack.id))) throw new Error("Stack IDs may contain only letters, digits, colon, underscore and dash.");
              ["telemetry_pipeline", "response_pipeline"].forEach((key) => {
                if (stack[key] !== undefined && !Array.isArray(stack[key])) throw new Error(`${key} must be an array.`);
                if ((stack[key] || []).length > 200) throw new Error("Import at most 200 stages per pipeline.");
                (stack[key] || []).forEach((stage) => { if (!stage || typeof stage !== "object" || Array.isArray(stage) || !SECURITY_STAGE_LIBRARY.some((known) => known.id === stage.stage)) throw new Error("Each imported stage must name a supported builder stage."); });
              });
            });
            if (!(await ivConfirm("Replace the local draft with this imported pipeline? Review stages and targets before explicitly saving. Importing does not apply live policy.", { title: "Import draft", confirmText: "Import draft" }))) return;
            ensurePipelineStateFromPolicy(candidate, true);
            window.ivPipelineDraftDirty = true;
            const errors = validatePipelineBeforeSave();
            renderPipelineBuilder();
            showToast(errors.length ? `Imported local draft needs review: ${errors[0]}` : "Imported into the local draft. Review targets and save deliberately to apply.", errors.length ? "error" : "info");
          } catch (error) {
            showToast(error.message || "Invalid pipeline file.", "error");
          } finally {
            event.target.value = "";
          }
        }